// Generated by CMake from wintangle.rc.in -- the version number comes from
// project() in the CMakeLists, so the executable and the git tag agree.
#include <windows.h>

APPICON ICON "wintangle.ico"

// The manifest is compiled in, so the executable stands on its own.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "wintangle.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @WINTANGLE_VERSION_COMMA@
PRODUCTVERSION @WINTANGLE_VERSION_COMMA@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"
        BEGIN
            VALUE "FileDescription", "WinTangle - window arrangement"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "wintangle"
            VALUE "OriginalFilename", "wintangle.exe"
            VALUE "ProductName", "WinTangle"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200
    END
END
